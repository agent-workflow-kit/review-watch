{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-watch/cli/accept-dry-run.json",
  "title": "accept --dry-run --json",
  "description": "Exit 0 prints the plan and plan_sha256. Exit 20 prints the plan beside the refusal (the error body).",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "dry_run": {
          "const": true
        },
        "round": {
          "$ref": "../defs.json#/$defs/round_id"
        },
        "plan": {
          "type": "object",
          "properties": {
            "plan_sha256": {
              "$ref": "../defs.json#/$defs/sha256"
            }
          },
          "required": [
            "plan_sha256"
          ],
          "additionalProperties": true,
          "x-untrusted": true,
          "description": "pr-comment's dry-run result (findings, moved, unanchored, neutralized counts, footer); untrusted, only plan_sha256 is relied on."
        },
        "plan_sha256": {
          "$ref": "../defs.json#/$defs/sha256"
        }
      },
      "additionalProperties": false,
      "required": [
        "dry_run",
        "round",
        "plan",
        "plan_sha256"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "../defs.json#/$defs/error_body"
        },
        "plan": {
          "type": "object",
          "properties": {
            "plan_sha256": {
              "$ref": "../defs.json#/$defs/sha256"
            }
          },
          "required": [
            "plan_sha256"
          ],
          "additionalProperties": true,
          "x-untrusted": true,
          "description": "pr-comment's dry-run result (findings, moved, unanchored, neutralized counts, footer); untrusted, only plan_sha256 is relied on."
        }
      },
      "additionalProperties": false,
      "required": [
        "error",
        "plan"
      ]
    }
  ]
}
