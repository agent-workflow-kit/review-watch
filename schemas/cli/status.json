{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-watch/cli/status.json",
  "title": "status --json",
  "description": "Does not contact a host. items and rounds are counts per state.",
  "type": "object",
  "properties": {
    "items": {
      "type": "object",
      "propertyNames": {
        "$ref": "../defs.json#/$defs/item_state"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "rounds": {
      "type": "object",
      "propertyNames": {
        "$ref": "../defs.json#/$defs/round_state"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "skipped": {
      "type": "object",
      "propertyNames": {
        "$ref": "../defs.json#/$defs/skip_reason"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "today": {
      "type": "object",
      "properties": {
        "rounds_started": {
          "type": "integer",
          "minimum": 0
        },
        "limit": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ],
          "description": "limits.rounds_per_day; null is off."
        }
      },
      "additionalProperties": false,
      "required": [
        "rounds_started",
        "limit"
      ]
    },
    "waiting": {
      "type": "object",
      "properties": {
        "waiting_slot": {
          "type": "integer",
          "minimum": 0
        },
        "daily_limit": {
          "type": "integer",
          "minimum": 0
        },
        "held": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "waiting_slot",
        "daily_limit",
        "held"
      ]
    },
    "last_poll": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "started_at": {
              "$ref": "../defs.json#/$defs/ts"
            },
            "finished_at": {
              "$ref": "../defs.json#/$defs/ts"
            },
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "host": {
                    "$ref": "../defs.json#/$defs/host"
                  },
                  "error": {
                    "oneOf": [
                      {
                        "$ref": "../defs.json#/$defs/failure_code"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "consecutive_failures": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "snapshots_deferred": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false,
                "required": [
                  "host",
                  "error",
                  "consecutive_failures",
                  "snapshots_deferred"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "started_at",
            "finished_at",
            "hosts"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "out_of_scope": {
      "type": "integer",
      "minimum": 0
    },
    "unmatched_repo_keys": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/repo_id"
      },
      "uniqueItems": true,
      "description": "repos.<id> keys that matched no seen repo in the last 30 days."
    },
    "gatectl": {
      "oneOf": [
        {
          "const": "not_configured"
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "policy": {
                "$ref": "../defs.json#/$defs/decision_id"
              },
              "repo": {
                "$ref": "../defs.json#/$defs/repo_id"
              },
              "stats": {
                "type": "object",
                "properties": {
                  "recommend": {},
                  "upper_bound": {}
                },
                "additionalProperties": true,
                "description": "gatectl stats --json passed through."
              }
            },
            "additionalProperties": false,
            "required": [
              "policy",
              "repo",
              "stats"
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "items",
    "rounds",
    "skipped",
    "today",
    "waiting",
    "last_poll",
    "out_of_scope",
    "unmatched_repo_keys",
    "gatectl"
  ]
}
