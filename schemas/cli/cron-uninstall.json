{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-watch/cli/cron-uninstall.json",
  "title": "cron uninstall --json",
  "description": "block is the block removed (or that would be removed) as a list of lines, null when none existed.",
  "type": "object",
  "properties": {
    "action": {
      "const": "uninstall"
    },
    "dry_run": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "block": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 4096
          },
          "maxItems": 16
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "action",
    "dry_run",
    "changed",
    "block"
  ]
}
