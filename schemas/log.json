{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-watch/log",
  "title": "review-watch log.jsonl record",
  "type": "object",
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "type": "string",
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "event": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "ts",
    "level",
    "event"
  ],
  "additionalProperties": true
}
