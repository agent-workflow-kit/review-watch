{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-watch/config.json",
  "title": "review-watch config",
  "description": "Self-contained (no external $ref). Unknown keys are refused. Defaults are those of docs/interface.md, Config. Cross-field and cross-document rules (docs/interface.md, Config validation) are loader checks that JSON Schema cannot express: per-repo tiers.lines, tiers.files, max_post_tier and max_approve_tier may only be lower or equal; auto_approve.enabled needs auto_post.enabled for the same repo; no safety key from the environment. The glob pattern covers the validation rules a regular expression can express (a loader check enforces the rest).",
  "type": "object",
  "properties": {
    "hosts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/host"
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Required. The host names to poll. The review account always comes from forgectl whoami."
    },
    "include": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glob"
      },
      "uniqueItems": true,
      "default": [
        "**"
      ],
      "description": "Repo-id globs (Path matching segment rules without the any-depth rule). Global only."
    },
    "exclude": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glob"
      },
      "uniqueItems": true,
      "default": [],
      "description": "Wins over include. Global only."
    },
    "me": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "The actor name; defaults to the OS username."
        }
      },
      "additionalProperties": false
    },
    "start": {
      "type": "object",
      "properties": {
        "external_authors": {
          "enum": [
            "skip",
            "review"
          ],
          "default": "skip",
          "description": "skip stores a request whose author does not belong as skipped (author_external); review restores starting for every author. Safety key: global only, never from the environment."
        }
      },
      "additionalProperties": false
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 3
    },
    "max_concurrent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64,
      "default": 2
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 2
    },
    "jobs": {
      "type": "object",
      "properties": {
        "use_jobsctl": {
          "enum": [
            "auto",
            true,
            false
          ],
          "default": "auto"
        },
        "queue": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,64}$",
          "default": "reviews"
        },
        "pass_env": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
          },
          "uniqueItems": true,
          "default": []
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "properties": {
        "skill": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "default": null
        },
        "previous": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "tiers": {
      "type": "object",
      "properties": {
        "lines": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          ],
          "items": false,
          "minItems": 2,
          "default": [
            50,
            300
          ],
          "description": "[medium, high] changed-line thresholds; a per-repo value may only be lower elementwise (loader check)."
        },
        "files": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 100000
            }
          ],
          "items": false,
          "minItems": 2,
          "default": [
            3,
            15
          ],
          "description": "[medium, high] changed-file thresholds; a per-repo value may only be lower elementwise (loader check)."
        },
        "sensitive_globs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/glob"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Paths that make a round at least tier 2; per-repo values add."
        },
        "trusted_authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/login"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Logins compared case-insensitively, applied only where author_association is null. Global only."
        },
        "allow_forks": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "off_limits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/glob"
      },
      "uniqueItems": true,
      "default": [
        ".github/**",
        ".gitlab-ci.yml",
        ".gitlab/**",
        ".circleci/**",
        "Jenkinsfile",
        "azure-pipelines.yml",
        "Dockerfile*",
        "docker-compose*",
        "Makefile",
        "GNUmakefile",
        ".husky/**",
        ".pre-commit-config.yaml",
        ".gitmodules",
        "**/.claude/**",
        ".mcp.json",
        "CLAUDE*.md",
        "AGENTS.md",
        "GEMINI.md",
        ".cursor/**",
        ".cursorrules",
        ".vscode/**",
        ".devcontainer/**",
        ".envrc",
        ".gitattributes",
        "CODEOWNERS",
        "**/auth/**",
        "**/security/**",
        "**/secrets/**",
        "**/crypto/**",
        "*.pem",
        "*.key",
        ".env",
        ".env.*"
      ],
      "description": "Matched after ASCII case folding; per-repo values add and never remove."
    },
    "max_post_tier": {
      "enum": [
        0,
        1,
        2,
        3
      ],
      "default": 1
    },
    "max_approve_tier": {
      "enum": [
        0,
        1,
        2,
        3
      ],
      "default": 0
    },
    "auto_post": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "policy": {
          "$ref": "#/$defs/policy_name",
          "default": "review-post"
        }
      },
      "additionalProperties": false
    },
    "auto_approve": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "policy": {
          "$ref": "#/$defs/policy_name",
          "default": "review-approve"
        },
        "trusted_author_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/host_account_id"
          },
          "uniqueItems": true,
          "default": [],
          "description": "Global only. Entries are <host>:<account id> and compare both parts; an automatic approve requires the PR author's entry here, and an entry also lets the author start a round (author_external)."
        }
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "string",
          "pattern": "^(?:[1-9]|[1-9][0-9]|[1-5][0-9]{2}|600)s$|^(?:[1-9]|10)m$",
          "default": "60s",
          "description": "A duration of 1 s to 600 s, passed to gatectl in whole seconds."
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "rounds_per_day": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 100000,
          "default": 50,
          "description": "Rounds counted per local day at their first launch; null is off."
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z0-9._/+-]{1,64}$",
          "default": null,
          "description": "An IANA zone name; null is the machine's local zone."
        }
      },
      "additionalProperties": false
    },
    "poll": {
      "type": "object",
      "properties": {
        "max_snapshots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 30
        },
        "failure_alert_after": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 3
        },
        "recheck_interval": {
          "$ref": "#/$defs/duration",
          "default": "1h"
        },
        "deadline": {
          "type": "string",
          "default": "20m",
          "pattern": "^(?:(?:[5-9]|[1-9][0-9]|1[01][0-9]|120)m|[12]h|(?:30[0-9]|3[1-9][0-9]|[4-6][0-9]{2}|[1-6][0-9]{3}|7[01][0-9]{2}|7200)s)$",
          "description": "The whole-cycle deadline, 5 m to 2 h."
        }
      },
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "closed": {
          "$ref": "#/$defs/duration",
          "default": "90d"
        },
        "log": {
          "$ref": "#/$defs/duration",
          "default": "180d"
        }
      },
      "additionalProperties": false
    },
    "cron": {
      "type": "object",
      "properties": {
        "schedule": {
          "type": "string",
          "pattern": "^[0-9A-Za-z*/,-]+(?: [0-9A-Za-z*/,-]+){4}$",
          "maxLength": 128,
          "default": "*/5 * * * *",
          "description": "Five fields of [0-9*/,-] or month and day names."
        },
        "env_file": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\x00-\\x1f\\x7f'%]+$",
          "default": null,
          "description": "Refused when it holds a control character, a single quote, a percent sign or a newline."
        }
      },
      "additionalProperties": false
    },
    "forgectl_cmd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "default": [
        "forgectl"
      ],
      "description": "An argv list run without a shell; absolute paths are recommended under cron."
    },
    "review_run_cmd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "default": [
        "review-run"
      ],
      "description": "An argv list run without a shell; absolute paths are recommended under cron."
    },
    "pr_comment_cmd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "default": [
        "pr-comment"
      ],
      "description": "An argv list run without a shell; absolute paths are recommended under cron."
    },
    "gatectl_cmd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "default": [
        "gatectl"
      ],
      "description": "An argv list run without a shell; absolute paths are recommended under cron."
    },
    "jobsctl_cmd": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minItems": 1,
      "default": [
        "jobsctl"
      ],
      "description": "An argv list run without a shell; absolute paths are recommended under cron."
    },
    "hooks": {
      "type": "object",
      "properties": {
        "pre-round": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "timeout": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 600
                  },
                  {
                    "$ref": "#/$defs/duration"
                  }
                ],
                "default": 30,
                "description": "A duration; a bare integer means seconds (1 to 600)."
              },
              "async": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "cmd"
            ]
          }
        },
        "post-draft": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "timeout": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 600
                  },
                  {
                    "$ref": "#/$defs/duration"
                  }
                ],
                "default": 30,
                "description": "A duration; a bare integer means seconds (1 to 600)."
              },
              "async": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "cmd"
            ]
          }
        },
        "post-attention": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "timeout": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 600
                  },
                  {
                    "$ref": "#/$defs/duration"
                  }
                ],
                "default": 30,
                "description": "A duration; a bare integer means seconds (1 to 600)."
              },
              "async": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "cmd"
            ]
          }
        },
        "post-post": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "timeout": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 600
                  },
                  {
                    "$ref": "#/$defs/duration"
                  }
                ],
                "default": 30,
                "description": "A duration; a bare integer means seconds (1 to 600)."
              },
              "async": {
                "type": "boolean"
              }
            },
            "additionalProperties": false,
            "required": [
              "cmd"
            ]
          }
        }
      },
      "additionalProperties": false,
      "default": {}
    },
    "repos": {
      "type": "object",
      "patternProperties": {
        "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]{1,5})?(?:/(?!\\.\\.?(?:/|$))[A-Za-z0-9._-]+)+$": {
          "type": "object",
          "properties": {
            "max_rounds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "max_attempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "max_concurrent": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "tiers": {
              "type": "object",
              "properties": {
                "lines": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "default": [
                    50,
                    300
                  ],
                  "description": "[medium, high] changed-line thresholds; a per-repo value may only be lower elementwise (loader check)."
                },
                "files": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "default": [
                    3,
                    15
                  ],
                  "description": "[medium, high] changed-file thresholds; a per-repo value may only be lower elementwise (loader check)."
                },
                "sensitive_globs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/glob"
                  },
                  "uniqueItems": true,
                  "default": [],
                  "description": "Paths that make a round at least tier 2; per-repo values add."
                },
                "allow_forks": {
                  "const": false,
                  "description": "A per-repo value may only be false."
                }
              },
              "additionalProperties": false
            },
            "max_post_tier": {
              "enum": [
                0,
                1,
                2,
                3
              ]
            },
            "max_approve_tier": {
              "enum": [
                0,
                1,
                2,
                3
              ]
            },
            "off_limits": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/glob"
              },
              "uniqueItems": true
            },
            "auto_post": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "policy": {
                  "$ref": "#/$defs/policy_name",
                  "default": "review-post"
                }
              },
              "additionalProperties": false
            },
            "auto_approve": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": false
                },
                "policy": {
                  "$ref": "#/$defs/policy_name",
                  "default": "review-approve"
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/glob"
                      },
                      {
                        "pattern": "/"
                      }
                    ]
                  },
                  "uniqueItems": true,
                  "default": [],
                  "description": "Anchored, case-sensitive; every entry must contain a /. An automatic approve requires every changed path (and previous_path) to match; empty means no automatic approve in this repo."
                }
              },
              "additionalProperties": false
            },
            "review": {
              "type": "object",
              "properties": {
                "skill": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "default": {}
    }
  },
  "required": [
    "hosts"
  ],
  "additionalProperties": false,
  "$defs": {
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)*(?::[0-9]{1,5})?$",
      "description": "Lowercase host, optional :port."
    },
    "duration": {
      "type": "string",
      "pattern": "^(?:0|[0-9]+(?:ms|s|m|h|d))$",
      "description": "0 or an integer and a unit (ms, s, m, h, d)."
    },
    "glob": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*/$)(?!.*//)(?!(?:.*/)?\\.\\.?(?:/|$))(?!.*[^/]\\*\\*)(?!.*\\*\\*[^/])(?!.*(?:^|/)(?:[^/*]*\\*){4})(?!(?:.*?(?:^|/)\\*\\*(?:/|$)){4})[A-Za-z0-9._*?/:@+-]+$",
      "description": "A repo-id or path glob (Path matching in docs/interface.md): * and ? match within a segment, a ** segment matches zero or more whole segments. Validated at load: no empty segment, no leading slash, no . or .. segment, ** only as a whole segment, at most three * in a segment and three ** in a pattern, at most 256 characters."
    },
    "login": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._@-]+$",
      "description": "An account login."
    },
    "policy_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "gatectl's policy name grammar; also valid inside the actor auto:<policy>."
    },
    "host_account_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?:[A-Za-z0-9][A-Za-z0-9:/_=.+-]{0,127}$",
      "description": "<host>:<account id>, the account id as forgectl reports it."
    }
  }
}
